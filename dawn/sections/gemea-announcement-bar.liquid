{%- comment -%}
  Bandeau d'annonce. Refermable : une fois écarté, il ne réapparaît pas
  pour ce visiteur. Le choix est gardé dans son navigateur, avec le texte
  en clé — changez le message et le bandeau revient, ce qui est bien le
  comportement attendu d'une nouvelle annonce.
{%- endcomment -%}

{%- if section.settings.text != blank -%}
  <div
    class="g-announcement"
    data-announcement
    data-key="{{ section.settings.text | strip | md5 }}"
    {% if section.settings.dismissible %}hidden{% endif %}
  >
    <div class="g-announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </div>

    {%- if section.settings.dismissible -%}
      <button
        class="g-announcement__close"
        type="button"
        data-announcement-close
        aria-label="Fermer"
      >
        {% render 'gemea-icon', name: 'close', size: 16 %}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Livraison offerte dès 50 € · Retours sous 30 jours"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien (optionnel)"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Refermable par le visiteur",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}

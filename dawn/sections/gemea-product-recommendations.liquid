{%- comment -%}
  « Produits associés ». Shopify ne renseigne `recommendations` que sur la
  requête dédiée : la section est vide au premier rendu et le script la
  remplace. La fiche ne paie donc pas le calcul des suggestions — ce qui
  compte quand le catalogue dépasse la centaine de références.
{%- endcomment -%}

<div
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section">
      <div class="page-width">
        <h2 class="section-title">{{ section.settings.heading }}</h2>

        <div class="carousel" data-carousel>
          <ul class="rail" data-carousel-track>
            {%- for product in recommendations.products -%}
              {% render 'gemea-product-card', card_product: product, show_vendor: false, quick_add: section.settings.quick_add %}
            {%- endfor -%}
          </ul>

          <div class="carousel__progress" data-progress aria-hidden="true"><span></span></div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Produits associés",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Produits associés" },
    {
      "type": "range",
      "id": "count",
      "label": "Nombre de produits",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Bouton d'ajout rapide sur la vignette",
      "default": true
    }
  ]
}
{% endschema %}

{%- comment -%}
  Bandeau pleine largeur, texte posé sur la photo.
  Un voile assombrit l'image : la charte interdit de poser le texte sur une
  photo chargée sans voile, et c'est aussi ce qui garantit la lisibilité.
{%- endcomment -%}
<section class="g-banner">
  {%- if section.settings.image != blank -%}
    <img
      class="g-banner__image"
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="
        {{ section.settings.image | image_url: width: 900 }} 900w,
        {{ section.settings.image | image_url: width: 1600 }} 1600w,
        {{ section.settings.image | image_url: width: 2400 }} 2400w
      "
      sizes="100vw"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="lazy"
    >
  {%- endif -%}

  <div class="g-banner__veil" style="background: rgb(15 15 15 / {{ section.settings.veil | divided_by: 100.0 }})"></div>

  <div class="g-banner__copy g-page-width g-page-width--narrow">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="g-btn g-btn--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pensé pour la vie de tous les jours" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Nos collections sont dessinées pour vous suivre partout — du bureau au dîner, de la semaine au week-end. Des pièces polyvalentes qui trouvent naturellement leur place dans votre quotidien."
    },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "range",
      "id": "veil",
      "label": "Intensité du voile",
      "info": "En dessous de 45 %, le texte devient illisible sur une photo claire.",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 55
    }
  ],
  "presets": [{ "name": "Bandeau image" }]
}
{% endschema %}

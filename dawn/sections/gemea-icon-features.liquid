{%- comment -%}
  Les garanties de la boutique : une icône, un titre, une phrase.
{%- endcomment -%}
<section class="section guarantees">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="guarantees__grid">
      {%- for block in section.blocks -%}
        <div class="guarantee" {{ block.shopify_attributes }}>
          {% render 'gemea-icon', name: block.settings.icon, size: 52 %}
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garanties",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre" }],
  "blocks": [
    {
      "type": "item",
      "name": "Garantie",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "globe", "label": "Monde" },
            { "value": "return", "label": "Retours" },
            { "value": "shield", "label": "Sécurité" },
            { "value": "award", "label": "Fidélité" },
            { "value": "truck", "label": "Livraison" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "gem", "label": "Matière" }
          ],
          "default": "globe"
        },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison mondiale" },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Recevez votre commande partout dans le monde"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garanties",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Avis clients en carrousel. Chaque carte peut porter le produit dont elle
  parle : c'est ce lien qui la rend utile plutôt que décorative.
{%- endcomment -%}
<section class="g-section g-testimonials">
  <div class="g-page-width">
    <h2 class="g-section-title">{{ section.settings.heading }}</h2>

    <div class="g-carousel" data-carousel>
      <ul class="g-rail g-rail--wide" data-carousel-track>
        {%- for block in section.blocks -%}
          <li class="g-tcard" {{ block.shopify_attributes }}>
            <div class="g-tcard__head">
              {%- if block.settings.avatar != blank -%}
                <img
                  class="g-tcard__avatar"
                  src="{{ block.settings.avatar | image_url: width: 160 }}"
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                >
              {%- else -%}
                <span class="g-tcard__avatar g-tcard__avatar--empty">{{ block.settings.author | slice: 0 }}</span>
              {%- endif -%}
              <div>
                <div class="g-tcard__author">{{ block.settings.author }}</div>
                {%- if block.settings.role != blank -%}
                  <div class="g-tcard__role">{{ block.settings.role }}</div>
                {%- endif -%}
              </div>
            </div>

            <blockquote class="g-tcard__quote"><p>{{ block.settings.text }}</p></blockquote>

            {%- assign item = block.settings.product -%}
            {%- if item != blank -%}
              <a class="g-tcard__product" href="{{ item.url }}">
                {%- if item.featured_media -%}
                  <img src="{{ item.featured_media | image_url: width: 200 }}" alt="" width="64" height="80" loading="lazy">
                {%- endif -%}
                <div>
                  {%- if item.vendor != blank -%}
                    <div class="g-tcard__vendor">{{ item.vendor }}</div>
                  {%- endif -%}
                  <div class="g-tcard__name">{{ item.title }}</div>
                  <div class="g-tcard__price">{% render 'gemea-price', target: item, show_from: true %}</div>
                </div>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="g-carousel__progress" data-progress aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Elles portent GEMEA au quotidien"
    }
  ],
  "blocks": [
    {
      "type": "avis",
      "name": "Avis",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Photo" },
        { "type": "text", "id": "author", "label": "Prénom et nom", "default": "Camille D." },
        { "type": "text", "id": "role", "label": "Ville ou fonction", "default": "Lyon" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "default": "Je la porte tous les jours depuis six mois, elle n'a pas bougé d'un ton. La finition est bien plus belle qu'en photo."
        },
        { "type": "product", "id": "product", "label": "Produit concerné" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [{ "type": "avis" }, { "type": "avis" }, { "type": "avis" }]
    }
  ]
}
{% endschema %}

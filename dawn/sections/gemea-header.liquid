<header class="g-header">
  <div class="g-page-width g-header__inner">
    <div class="g-header__left">
      <button
        class="g-header__icon g-menu-toggle"
        type="button"
        data-drawer-toggle
        aria-expanded="false"
        aria-label="Menu"
      >
        <span class="g-menu-toggle__open">{% render 'gemea-icon', name: 'menu', size: 20 %}</span>
        <span class="g-menu-toggle__close">{% render 'gemea-icon', name: 'close', size: 20 %}</span>
      </button>

      <a class="g-header__icon" href="{{ routes.search_url }}" aria-label="Recherche">
        {% render 'gemea-icon', name: 'search' %}
      </a>

      <nav class="g-header__nav">
        {%- for link in section.settings.menu.links -%}
          <a class="g-nav-link" href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {%- endfor -%}
      </nav>
    </div>

    <a class="g-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="max-height: {{ section.settings.logo_height }}px"
        >
      {%- else -%}
        <span class="g-wordmark">{{ shop.name | upcase | strip }}</span>
      {%- endif -%}
    </a>

    <div class="g-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <a class="g-header__icon" href="{{ routes.account_url }}" aria-label="Mon compte">
          {% render 'gemea-icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a class="g-header__icon g-header__cart" href="{{ routes.cart_url }}" aria-label="Panier">
        {% render 'gemea-icon', name: 'cart' %}
        <span class="g-cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

</header>

{% render 'gemea-menu-drawer', menu: section.settings.menu, section: section %}

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Hauteur du logo",
      "min": 24,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "blocks": [
    {
      "type": "utility",
      "name": "Lien pratique",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "account",
              "label": "Compte"
            },
            {
              "value": "heart",
              "label": "Favoris"
            },
            {
              "value": "ruler",
              "label": "Guide des tailles"
            },
            {
              "value": "message",
              "label": "Contact"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "return",
              "label": "Retours"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "gem",
              "label": "Matière"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            }
          ],
          "default": "account"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Mon compte"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    },
    {
      "type": "reassurance",
      "name": "Réassurance",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "account",
              "label": "Compte"
            },
            {
              "value": "heart",
              "label": "Favoris"
            },
            {
              "value": "ruler",
              "label": "Guide des tailles"
            },
            {
              "value": "message",
              "label": "Contact"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "return",
              "label": "Retours"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "gem",
              "label": "Matière"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            }
          ],
          "default": "gem"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Argent 925"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Des matériaux nobles et durables"
        }
      ]
    }
  ]
}
{% endschema %}

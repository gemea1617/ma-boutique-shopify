{%- comment -%}
  Carte produit.
  Accepte : card_product, show_vendor (bool), quick_add (bool).

  L'ajout rapide envoie la première variante disponible au panier sans
  quitter la page. Il n'apparaît que si le produit n'a qu'une variante —
  au-delà, le client doit choisir, et le raccourci deviendrait un piège.
{%- endcomment -%}

{%- if card_product and card_product != empty -%}
  {%- assign variant = card_product.selected_or_first_available_variant -%}
  <li class="g-card">
    <div class="g-card__media">
      <a href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
        {%- if card_product.featured_media -%}
          <img
            class="g-card__img--main"
            src="{{ card_product.featured_media | image_url: width: 800 }}"
            srcset="
              {{ card_product.featured_media | image_url: width: 400 }} 400w,
              {{ card_product.featured_media | image_url: width: 800 }} 800w
            "
            sizes="(min-width: 1200px) 320px, (min-width: 750px) 30vw, 45vw"
            alt="{{ card_product.featured_media.alt | escape }}"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
            loading="lazy"
          >
          {%- if card_product.media[1] -%}
            <img
              class="g-card__img--hover"
              src="{{ card_product.media[1] | image_url: width: 800 }}"
              alt=""
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
              loading="lazy"
            >
          {%- endif -%}
        {%- else -%}
          <span class="g-placeholder">{% render 'gemea-logo', width: 62, unique_id: card_product.id %}</span>
        {%- endif -%}
      </a>

      {%- if card_product.available == false -%}
        <span class="g-card__badge g-card__badge--sold">Épuisé</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        <span class="g-card__badge">Promo</span>
      {%- endif -%}

      {%- if quick_add and card_product.available and card_product.variants.size == 1 -%}
        <button
          class="g-card__add"
          type="button"
          data-quick-add="{{ variant.id }}"
          aria-label="Ajouter au panier"
          title="Ajouter au panier"
        >
          {% render 'gemea-icon', name: 'cart', size: 17 %}
        </button>
      {%- endif -%}
    </div>

    <div class="g-card__info">
      {%- if show_vendor and card_product.vendor != blank -%}
        <div class="g-card__vendor">{{ card_product.vendor }}</div>
      {%- endif -%}
      <a class="g-card__title" href="{{ card_product.url }}">{{ card_product.title }}</a>
      <div class="g-card__price">{% render 'gemea-price', target: card_product, show_from: true %}</div>
    </div>
  </li>
{%- else -%}
  {%- comment -%} Squelette affiché dans l'éditeur tant qu'aucun produit n'est choisi {%- endcomment -%}
  <li class="g-card">
    <div class="g-card__media">
      <span class="g-placeholder">{% render 'gemea-logo', width: 62, unique_id: 'ph' %}</span>
    </div>
    <div class="g-card__info">
      <span class="g-card__title">Nom du produit</span>
      <div class="g-card__price">{{ 1990 | money }}</div>
    </div>
  </li>
{%- endif -%}

<section class="section">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <ul class="product-grid" style="list-style:none">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <li {{ block.shopify_attributes }}>
          <a class="collection-tile" href="{{ col.url | default: '#' }}">
            {%- if col.featured_image -%}
              <img
                src="{{ col.featured_image | image_url: width: 800 }}"
                alt="{{ col.featured_image.alt | escape }}"
                width="{{ col.featured_image.width }}"
                height="{{ col.featured_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="placeholder">{% render 'logo', width: 80, unique_id: block.id %}</span>
            {%- endif -%}
            <span class="collection-tile__label">
              {{ block.settings.title | default: col.title | default: 'Collection' }}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Liste de collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Par catégorie" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Explorer" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre affiché (optionnel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liste de collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}

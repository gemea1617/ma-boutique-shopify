<div class="page-width section">
  <header class="collection-header" style="padding-top:0">
    <p class="eyebrow">{{ 'blogs.eyebrow' | t }}</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 9 -%}
    <ul class="product-grid" style="list-style:none">
      {%- for article in blog.articles -%}
        <li>
          <a class="card__media" href="{{ article.url }}" style="aspect-ratio:3/2">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="placeholder">{% render 'logo', width: 70, unique_id: article.id %}</span>
            {%- endif -%}
          </a>
          <div class="card__info" style="text-align:left">
            <p class="eyebrow" style="margin:14px 0 8px">{{ article.published_at | date: '%d.%m.%Y' }}</p>
            <a class="card__title" href="{{ article.url }}">{{ article.title }}</a>
            <p class="mention" style="margin-top:10px">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Journal" }
{% endschema %}

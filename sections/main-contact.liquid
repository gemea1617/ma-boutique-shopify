<div class="page-width page-width--narrow section">
  <div style="text-align:center; margin-bottom:40px">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="rte" style="margin-top:14px">{{ page.content }}</div>
    {%- endif -%}
  </div>

  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label for="ContactName">{{ 'contact.name' | t }}</label>
      <input id="ContactName" type="text" name="contact[name]" autocomplete="name">
    </div>

    <div class="field">
      <label for="ContactEmail">{{ 'contact.email' | t }}</label>
      <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required>
    </div>

    <div class="field">
      <label for="ContactBody">{{ 'contact.message' | t }}</label>
      <textarea id="ContactBody" name="contact[body]" required></textarea>
    </div>

    <button class="btn" type="submit">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Une question ?" }]
}
{% endschema %}

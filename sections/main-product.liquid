{%- liquid
  assign current = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}

<div class="page-width">
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pdp" data-pdp data-product-id="{{ product.id }}">
    {%- comment -%} ------------------------------------------------ Galerie {%- endcomment -%}
    <div class="gallery" data-gallery>
      {%- if media_count > 1 -%}
        <div class="gallery__rail">
          <div class="gallery__thumbs" data-thumbs>
            {%- for media in product.media -%}
              <button
                type="button"
                data-thumb
                data-index="{{ forloop.index0 }}"
                data-full="{{ media | image_url: width: 1400 }}"
                data-alt="{{ media.alt | escape }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 200 }}"
                  alt=""
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>

          {%- comment -%}
            Le rail défile plutôt que de s'allonger : au-delà de cinq visuels
            la flèche descend d'un cran, comme sur la maquette.
          {%- endcomment -%}
          {%- if media_count > 5 -%}
            <button class="gallery__rail-more" type="button" data-rail-scroll aria-label="{{ 'products.product.media_next' | t }}">
              {% render 'icon', name: 'arrow-down', size: 15 %}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gallery__stage" data-stage>
        {%- if media_count > 0 -%}
          <img
            data-stage-image
            src="{{ product.featured_media | image_url: width: 1400 }}"
            srcset="
              {{ product.featured_media | image_url: width: 700 }} 700w,
              {{ product.featured_media | image_url: width: 1400 }} 1400w,
              {{ product.featured_media | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            fetchpriority="high"
          >

          {%- if media_count > 1 -%}
            <button class="gallery__arrow gallery__arrow--prev" type="button" data-step="-1" aria-label="{{ 'products.product.media_previous' | t }}">
              {% render 'icon', name: 'arrow-left', size: 16 %}
            </button>
            <button class="gallery__arrow gallery__arrow--next" type="button" data-step="1" aria-label="{{ 'products.product.media_next' | t }}">
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </button>
          {%- endif -%}

          <button class="gallery__zoom" type="button" data-zoom-open aria-label="{{ 'products.product.zoom' | t }}">
            {% render 'icon', name: 'expand', size: 16 %}
          </button>
        {%- else -%}
          <span class="placeholder">{% render 'logo', width: 120, unique_id: 'product' %}</span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} -------------------------------------------- Informations {%- endcomment -%}
    <div class="pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'badge' -%}
            {%- if block.settings.tag == blank or product.tags contains block.settings.tag -%}
              <span class="pdp__badge" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div class="price-row" {{ block.shopify_attributes }}>
              <span class="amount" data-variant-price>{% render 'price', target: current %}</span>
              {%- assign saved = 0 -%}
              {%- if current.compare_at_price > current.price -%}
                {%- assign saved = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price -%}
              {%- endif -%}
              <span class="badge-save" data-save {% if saved == 0 %}hidden{% endif %}>
                {{- 'products.product.save' | t: percent: saved -}}
              </span>
            </div>

          {%- when 'rating' -%}
            {%- assign rating = product.metafields.reviews.rating.value -%}
            {%- if rating != blank and rating.rating > 0 -%}
              {%- assign filled = rating.rating | round -%}
              {%- assign count = product.metafields.reviews.rating_count.value -%}
              <a class="stars" href="#avis" {{ block.shopify_attributes }}>
                <span class="stars__marks" aria-hidden="true">
                  {%- for i in (1..5) -%}{% if i <= filled %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
                </span>
                <span class="stars__count">
                  {{ rating.rating }}/{{ rating.scale_max }}
                  {%- if count > 0 %} ({{ 'products.product.reviews' | t: count: count }}){% endif -%}
                </span>
              </a>
            {%- endif -%}

          {%- when 'pitch' -%}
            {%- if block.settings.text != blank -%}
              <div class="pdp__pitch rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'arguments' -%}
            <ul class="pdp__args" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign label_key = 'label_' | append: i -%}
                {%- assign icon_key = 'icon_' | append: i -%}
                {%- assign label = block.settings[label_key] -%}
                {%- if label != blank -%}
                  <li>
                    {% render 'icon', name: block.settings[icon_key], size: 17 %}
                    <span>{{ label }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'form' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product',
                product,
                id: 'ProductForm',
                class: 'pdp__form',
                novalidate: 'novalidate',
                data-variants: ''
              -%}
                <script type="application/json" data-variants-json>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available }},
                        "media_index": {{ variant.featured_media.position | default: 0 | minus: 1 }},
                        "price_html": {{ variant.price | money | json }},
                        "compare_html": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}null{%- endif -%},
                        "save_percent": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}{%- else -%}0{%- endif -%}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>

                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign index0 = forloop.index0
                      assign name_key = option.name | downcase
                      assign is_swatch = false
                      if name_key contains 'couleur' or name_key contains 'color' or name_key contains 'coloris' or name_key contains 'finition'
                        assign is_swatch = true
                      endif
                    -%}

                    <fieldset class="opt" data-option-index="{{ index0 }}">
                      <div class="opt__head">
                        <legend class="opt__label">{{ option.name }}</legend>
                        {%- if block.settings.size_guide != blank and forloop.first -%}
                          <a class="opt__guide" href="{{ block.settings.size_guide }}">
                            {% render 'icon', name: 'ruler', size: 13 %}
                            {{ block.settings.size_guide_label }}
                          </a>
                        {%- else -%}
                          <span class="opt__chosen" data-option-chosen>{{ option.selected_value }}</span>
                        {%- endif -%}
                      </div>

                      <div class="opt__values{% if is_swatch %} opt__values--swatch{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign value_available = false
                            assign swatch_image = null
                            for variant in product.variants
                              if variant.options[index0] == value
                                if variant.available
                                  assign value_available = true
                                endif
                                if swatch_image == null and variant.image
                                  assign swatch_image = variant.image
                                endif
                              endif
                            endfor
                          -%}

                          {%- if is_swatch and swatch_image -%}
                            <label class="swatch{% unless value_available %} swatch--out{% endunless %}" data-value-label>
                              <input
                                type="radio"
                                name="option-{{ option.position }}"
                                value="{{ value | escape }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              <img src="{{ swatch_image | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">
                              <span class="swatch__name">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="pill{% unless value_available %} pill--out{% endunless %}" data-value-label>
                              <input
                                type="radio"
                                name="option-{{ option.position }}"
                                value="{{ value | escape }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              {{ value }}
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

                <div class="buy">
                  <button
                    class="btn btn--full"
                    type="submit"
                    name="add"
                    data-add-button
                    data-add="{{ 'products.product.add_to_cart' | t }}"
                    data-sold-out="{{ 'products.product.sold_out' | t }}"
                    {% unless current.available %}disabled{% endunless %}
                  >
                    {%- if current.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </button>

                  {%- if block.settings.show_wishlist -%}
                    {%- comment -%}
                      Le cœur mémorise l'envie dans le navigateur du visiteur.
                      Sans compte client, c'est tout ce qu'on peut promettre
                      honnêtement — et ça suffit à retrouver la pièce plus tard.
                    {%- endcomment -%}
                    <button
                      class="btn-icon"
                      type="button"
                      data-wishlist="{{ product.id }}"
                      aria-pressed="false"
                      aria-label="{{ 'products.product.wishlist' | t }}"
                      title="{{ 'products.product.wishlist' | t }}"
                    >
                      {% render 'icon', name: 'heart', size: 18 %}
                    </button>
                  {%- endif -%}
                </div>

                <p
                  class="stock{% unless current.available %} stock--out{% endunless %}"
                  data-stock
                  data-in-stock="{{ 'products.product.in_stock' | t }}"
                  data-sold-out="{{ 'products.product.sold_out' | t }}"
                >
                  {%- if current.available -%}
                    {{ 'products.product.in_stock' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </p>
              {%- endform -%}
            </div>

          {%- when 'payment' -%}
            <div class="pdp__payment" {{ block.shopify_attributes }}>
              {%- if block.settings.note != blank -%}
                <p class="mention">{{ block.settings.note }}</p>
              {%- endif -%}
              {%- if shop.enabled_payment_types.size > 0 -%}
                <div class="payment-icons">
                  {%- for type in shop.enabled_payment_types -%}
                    {{ type | payment_type_svg_tag }}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Visionneuse plein écran, ouverte par la loupe de la galerie {%- endcomment -%}
<dialog class="lightbox" data-lightbox>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="{{ 'general.close' | t }}">
    {% render 'icon', name: 'close', size: 20 %}
  </button>
  <img data-lightbox-image src="" alt="">
</dialog>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Page produit",
  "blocks": [
    {
      "type": "badge",
      "name": "Étiquette",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Nouveauté" },
        {
          "type": "text",
          "id": "tag",
          "label": "Balise produit",
          "info": "L'étiquette n'apparaît que sur les produits portant cette balise. Vide : sur tous.",
          "default": "nouveaute"
        }
      ]
    },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    {
      "type": "rating",
      "name": "Note",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "La note vient des métachamps d'avis de la boutique. Sans avis enregistré, rien ne s'affiche."
        }
      ]
    },
    {
      "type": "pitch",
      "name": "Accroche",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Un design organique inspiré par le mouvement des vagues. Minimaliste et intemporelle, la bague Onde se porte seule ou en accumulation.</p>"
        }
      ]
    },
    {
      "type": "arguments",
      "name": "Arguments",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icône 1",
          "options": [
            { "value": "gem", "label": "Pierre" },
            { "value": "water", "label": "Eau" },
            { "value": "shield", "label": "Garantie" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retours" },
            { "value": "leaf", "label": "Durable" }
          ],
          "default": "gem"
        },
        { "type": "text", "id": "label_1", "label": "Texte 1", "default": "Argent 925" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icône 2",
          "options": [
            { "value": "gem", "label": "Pierre" },
            { "value": "water", "label": "Eau" },
            { "value": "shield", "label": "Garantie" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retours" },
            { "value": "leaf", "label": "Durable" }
          ],
          "default": "water"
        },
        { "type": "text", "id": "label_2", "label": "Texte 2", "default": "Résiste à l'eau" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icône 3",
          "options": [
            { "value": "gem", "label": "Pierre" },
            { "value": "water", "label": "Eau" },
            { "value": "shield", "label": "Garantie" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retours" },
            { "value": "leaf", "label": "Durable" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "label_3", "label": "Texte 3", "default": "Garantie 2 ans" }
      ]
    },
    {
      "type": "form",
      "name": "Choix et panier",
      "limit": 1,
      "settings": [
        { "type": "url", "id": "size_guide", "label": "Lien du guide des tailles" },
        {
          "type": "text",
          "id": "size_guide_label",
          "label": "Libellé du guide",
          "default": "Guide des tailles"
        },
        { "type": "checkbox", "id": "show_wishlist", "label": "Bouton favori", "default": true }
      ]
    },
    {
      "type": "payment",
      "name": "Paiement",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "note",
          "label": "Mention",
          "default": "Paiement en 3x sans frais dès 50 €"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page produit",
      "blocks": [
        { "type": "badge" },
        { "type": "title" },
        { "type": "price" },
        { "type": "rating" },
        { "type": "pitch" },
        { "type": "arguments" },
        { "type": "form" },
        { "type": "payment" }
      ]
    }
  ]
}
{% endschema %}

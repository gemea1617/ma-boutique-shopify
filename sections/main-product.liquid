{%- liquid
  assign current = product.selected_or_first_available_variant
-%}

<div class="page-width">
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true"> / </span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true"> / </span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product" style="padding-bottom: var(--section-y)">
    <div class="product__gallery" data-gallery>
      {%- if product.media.size > 0 -%}
        <img
          data-gallery-main
          src="{{ product.featured_media | image_url: width: 1200 }}"
          srcset="
            {{ product.featured_media | image_url: width: 600 }} 600w,
            {{ product.featured_media | image_url: width: 1200 }} 1200w,
            {{ product.featured_media | image_url: width: 1800 }} 1800w
          "
          sizes="(min-width: 900px) 55vw, 100vw"
          alt="{{ product.featured_media.alt | escape }}"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}"
          fetchpriority="high"
        >

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                data-gallery-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                data-alt="{{ media.alt | escape }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 160 }}"
                  alt=""
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="placeholder" style="aspect-ratio:4/5">
          {% render 'logo', width: 120, unique_id: 'product' %}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div class="product__price" data-variant-price {{ block.shopify_attributes }}>
              {% render 'price', target: current %}
            </div>
            <p class="mention">{{ block.settings.mention }}</p>

          {%- when 'form' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product',
                product,
                id: 'ProductForm',
                class: 'product__form',
                novalidate: 'novalidate',
                data-variants: ''
              -%}
                <script type="application/json" data-variants-json>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available }},
                        "price_html": {{ variant.price | money | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>

                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <fieldset class="option" data-option-index="{{ forloop.index0 }}" style="border:0;padding:0;margin:0">
                      <legend class="option__label">{{ option.name }}</legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          <label class="option__value">
                            <input
                              type="radio"
                              name="option-{{ option.position }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

                <div class="option">
                  <label class="option__label" for="Quantity">{{ 'products.product.quantity' | t }}</label>
                  <div class="qty" data-qty>
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
                    <input id="Quantity" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
                  </div>
                </div>

                <button
                  class="btn btn--full"
                  type="submit"
                  name="add"
                  data-add-button
                  data-add="{{ 'products.product.add_to_cart' | t }}"
                  data-sold-out="{{ 'products.product.sold_out' | t }}"
                  {% unless current.available %}disabled{% endunless %}
                >
                  {%- if current.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>

          {%- when 'reassurance' -%}
            <div class="reassurance" {{ block.shopify_attributes }}>
              <ul>
                {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}
                    <li>{% render 'icon', name: 'gem', size: 15 %}{{ trimmed }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'description' -%}
            <div class="product__meta" {{ block.shopify_attributes }}>
              <details class="accordion" open>
                <summary>{{ 'products.product.description' | t }}</summary>
                <div class="accordion__body rte">{{ product.description }}</div>
              </details>
            </div>

          {%- when 'accordion' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="accordion__body rte">{{ block.settings.content }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Page produit",
  "blocks": [
    { "type": "vendor", "name": "Marque", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "mention",
          "label": "Mention sous le prix",
          "default": "Taxes incluses. Livraison calculée au paiement."
        }
      ]
    },
    { "type": "form", "name": "Choix et panier", "limit": 1 },
    {
      "type": "reassurance",
      "name": "Réassurance",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "lines",
          "label": "Lignes (une par ligne)",
          "default": "Plaqué or 18 carats, 3 microns\nRésistant à l'eau et au quotidien\nExpédié sous 24 h depuis la France\nRetours gratuits sous 30 jours"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "accordion",
      "name": "Bloc dépliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison et retours" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenu",
          "default": "<p>Expédition sous 24 h ouvrées. Livraison offerte dès 50 €. Retours gratuits sous 30 jours.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page produit",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "form" },
        { "type": "reassurance" },
        { "type": "description" },
        { "type": "accordion" }
      ]
    }
  ]
}
{% endschema %}

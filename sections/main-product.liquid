{%- comment -%}
  Fiche produit, calquée sur la structure de Vestra :
  visuel + vignettes dessous, puis la colonne d'achat dans cet ordre —
  marque, titre, prix, mention de taxes, accroche, filet, disponibilité,
  quantité, guide des tailles, panier, paiement express, arguments à coche,
  accordéons, partage.

  Les couleurs et la typographie viennent de la charte GEMEA, pas de Vestra.
{%- endcomment -%}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}

<div class="page-width">
  <div class="pdp" data-pdp data-product-id="{{ product.id }}">
    <div class="gallery" data-gallery>
      <div class="gallery__stage" data-stage>
        {%- if media_count > 0 -%}
          <img
            data-stage-image
            src="{{ product.featured_media | image_url: width: 1400 }}"
            srcset="
              {{ product.featured_media | image_url: width: 700 }} 700w,
              {{ product.featured_media | image_url: width: 1400 }} 1400w,
              {{ product.featured_media | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            fetchpriority="high"
          >

          <button class="gallery__zoom" type="button" data-zoom-open aria-label="{{ 'products.product.zoom' | t }}">
            {% render 'icon', name: 'expand', size: 16 %}
          </button>
        {%- else -%}
          <span class="placeholder">{% render 'logo', width: 120, unique_id: 'product' %}</span>
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        <div class="gallery__thumbs" data-thumbs>
          {%- for media in product.media -%}
            <button
              type="button"
              data-thumb
              data-index="{{ forloop.index0 }}"
              data-full="{{ media | image_url: width: 1400 }}"
              data-alt="{{ media.alt | escape }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}"
            >
              <img
                src="{{ media | image_url: width: 300 }}"
                alt=""
                width="{{ media.width }}"
                height="{{ media.height }}"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="pdp__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="price-row">
                <span class="amount" data-variant-price>{% render 'price', target: current %}</span>
                {%- assign saved = 0 -%}
                {%- if current.compare_at_price > current.price -%}
                  {%- assign saved = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price -%}
                {%- endif -%}
                <span class="badge-save" data-save {% if saved == 0 %}hidden{% endif %}>
                  {{- 'products.product.save' | t: percent: saved -}}
                </span>
              </div>
              {%- if block.settings.note != blank -%}
                <p class="pdp__tax">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>

          {%- when 'pitch' -%}
            {%- if block.settings.text != blank -%}
              <div class="pdp__pitch rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'divider' -%}
            <hr class="pdp__rule" {{ block.shopify_attributes }}>

          {%- when 'stock' -%}
            <p
              class="stock{% unless current.available %} stock--out{% endunless %}"
              data-stock
              data-in-stock="{{ block.settings.in_stock }}"
              data-sold-out="{{ 'products.product.sold_out' | t }}"
              {{ block.shopify_attributes }}
            >
              {%- if current.available -%}{{ block.settings.in_stock }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </p>

          {%- when 'form' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product',
                product,
                id: 'ProductForm',
                class: 'pdp__form',
                novalidate: 'novalidate',
                data-variants: ''
              -%}
                <script type="application/json" data-variants-json>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available }},
                        "media_index": {{ variant.featured_media.position | default: 0 | minus: 1 }},
                        "price_html": {{ variant.price | money | json }},
                        "compare_html": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}null{%- endif -%},
                        "save_percent": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}{%- else -%}0{%- endif -%}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>

                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign index0 = forloop.index0
                      assign name_key = option.name | downcase
                      assign is_swatch = false
                      if name_key contains 'couleur' or name_key contains 'color' or name_key contains 'coloris' or name_key contains 'finition'
                        assign is_swatch = true
                      endif
                    -%}

                    <fieldset class="opt" data-option-index="{{ index0 }}">
                      <div class="opt__head">
                        <legend class="opt__label">{{ option.name }}</legend>
                        <span class="opt__chosen" data-option-chosen>{{ option.selected_value }}</span>
                      </div>

                      <div class="opt__values{% if is_swatch %} opt__values--swatch{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign value_available = false
                            assign swatch_image = null
                            for variant in product.variants
                              if variant.options[index0] == value
                                if variant.available
                                  assign value_available = true
                                endif
                                if swatch_image == null and variant.image
                                  assign swatch_image = variant.image
                                endif
                              endif
                            endfor
                          -%}

                          {%- if is_swatch and swatch_image -%}
                            <label class="swatch{% unless value_available %} swatch--out{% endunless %}" data-value-label>
                              <input
                                type="radio"
                                name="option-{{ option.position }}"
                                value="{{ value | escape }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              <img src="{{ swatch_image | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">
                              <span class="swatch__name">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="pill{% unless value_available %} pill--out{% endunless %}" data-value-label>
                              <input
                                type="radio"
                                name="option-{{ option.position }}"
                                value="{{ value | escape }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              {{ value }}
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

                <div class="qty-field">
                  <label class="opt__label" for="Quantity">{{ 'products.product.quantity' | t }}</label>
                  <div class="qty" data-qty>
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
                    <input id="Quantity" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
                  </div>
                </div>

                {%- if block.settings.size_guide != blank -%}
                  <a class="size-guide" href="{{ block.settings.size_guide }}">
                    <span class="size-guide__icon">{% render 'icon', name: 'ruler', size: 15 %}</span>
                    {{ block.settings.size_guide_label }}
                  </a>
                {%- endif -%}

                <div class="buy">
                  <button
                    class="btn btn--full"
                    type="submit"
                    name="add"
                    data-add-button
                    data-add="{{ 'products.product.add_to_cart' | t }}"
                    data-sold-out="{{ 'products.product.sold_out' | t }}"
                    {% unless current.available %}disabled{% endunless %}
                  >
                    {%- if current.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </button>

                  {%- if block.settings.show_payment_button -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                </div>
              {%- endform -%}
            </div>

          {%- when 'features' -%}
            <ul class="features" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign key = 'text_' | append: i -%}
                {%- assign line = block.settings[key] -%}
                {%- if line != blank -%}
                  <li>{% render 'icon', name: 'check', size: 20 %}<span>{{ line }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            <details class="accordion" open {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="accordion__body rte">{{ product.description }}</div>
            </details>

          {%- when 'accordion' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="accordion__body rte">{{ block.settings.content }}</div>
            </details>

          {%- when 'share' -%}
            {%- assign share_url = shop.url | append: product.url | url_encode -%}
            {%- assign share_title = product.title | url_encode -%}
            <div class="share" {{ block.shopify_attributes }}>
              <span class="share__label">{{ 'products.product.share' | t }}</span>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                {% render 'icon', name: 'facebook', size: 18 %}
              </a>
              <a href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="X">
                {% render 'icon', name: 'x', size: 18 %}
              </a>
              <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Pinterest">
                {% render 'icon', name: 'pinterest', size: 18 %}
              </a>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<dialog class="lightbox" data-lightbox>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="{{ 'general.close' | t }}">
    {% render 'icon', name: 'close', size: 20 %}
  </button>
  <img data-lightbox-image src="" alt="">
</dialog>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Page produit",
  "blocks": [
    { "type": "vendor", "name": "Marque", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "note",
          "label": "Mention sous le prix",
          "default": "Taxes incluses. Livraison calculée au paiement."
        }
      ]
    },
    {
      "type": "pitch",
      "name": "Accroche",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Des bijoux pensés pour accompagner chaque journée, du bureau au dîner, sans jamais avoir à y penser.</p>"
        }
      ]
    },
    { "type": "divider", "name": "Filet" },
    {
      "type": "stock",
      "name": "Disponibilité",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "in_stock", "label": "Texte en stock", "default": "En stock" }
      ]
    },
    {
      "type": "form",
      "name": "Choix et panier",
      "limit": 1,
      "settings": [
        { "type": "url", "id": "size_guide", "label": "Lien du guide des tailles" },
        { "type": "text", "id": "size_guide_label", "label": "Libellé", "default": "Guide des tailles" },
        { "type": "checkbox", "id": "show_payment_button", "label": "Paiement express", "default": true }
      ]
    },
    {
      "type": "features",
      "name": "Arguments à coche",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Ligne 1", "default": "Argent 925 massif, hypoallergénique" },
        { "type": "text", "id": "text_2", "label": "Ligne 2", "default": "Expédié sous 24 h depuis la France" },
        { "type": "text", "id": "text_3", "label": "Ligne 3", "default": "Retours offerts sous 30 jours" }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Description" }
      ]
    },
    {
      "type": "accordion",
      "name": "Bloc dépliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison & retours" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenu",
          "default": "<p>Livraison offerte dès 100 € d'achat, expédition sous 24 h ouvrées. Retours gratuits sous 30 jours.</p>"
        }
      ]
    },
    { "type": "share", "name": "Partage", "limit": 1 }
  ],
  "presets": [
    {
      "name": "Page produit",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "pitch" },
        { "type": "divider" },
        { "type": "stock" },
        { "type": "form" },
        { "type": "features" },
        { "type": "description" },
        { "type": "accordion" },
        { "type": "share" }
      ]
    }
  ]
}
{% endschema %}

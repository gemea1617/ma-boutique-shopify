<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="wordmark">{{ shop.name | upcase | strip }}</div>
        {%- if section.settings.tagline != blank -%}
          <div class="rte footer__tagline">{{ section.settings.tagline }}</div>
        {%- endif -%}

        <div class="social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | strip }} — {{ 'general.rights' | t }}</span>
      <nav class="footer__legal">
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Accroche",
      "default": "<p>Bijoux en argent 925 imaginés à Paris.<br/>Des pièces intemporelles, pour chaque moment de votre vie.</p>"
    },
    { "type": "link_list", "id": "legal_menu", "label": "Menu légal" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [{ "name": "Pied de page" }]
}
{% endschema %}

<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        {% render 'logo', width: 60, stroke: '#FAF9F7', unique_id: 'footer' %}
        <div class="wordmark" style="margin-top:14px">{{ shop.name | upcase | strip }}</div>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | strip }}</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Accroche",
      "default": "Bijoux plaqué or 18 carats, résistants à l'eau, pensés pour le quotidien."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Nous écrire" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>bonjour@gemeajewels.com</p>" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [{ "name": "Pied de page" }]
}
{% endschema %}

<section class="section">
  <div class="page-width">
    <div class="row-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link != blank -%}
        <a class="link-line" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="accordion__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "FAQ" },
    { "type": "url", "id": "link", "label": "Lien" },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du lien",
      "default": "Voir toutes les questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Le bijou résiste-t-il à l'eau ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Oui. Douche, piscine, mer : le plaquage 3 microns tient. Rincez à l'eau claire après la mer, c'est tout.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}

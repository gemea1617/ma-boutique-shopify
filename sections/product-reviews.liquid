{%- comment -%}
  Avis clients. La note et le nombre d'avis viennent des métachamps de la
  boutique, donc du produit réellement affiché. Les citations, elles, sont
  choisies dans l'éditeur : elles servent de vitrine et sont les mêmes sur
  toutes les fiches.

  Un bloc d'application peut être inséré ici (Yotpo, Judge.me, Loox…) pour
  afficher les vrais avis à la place des citations.
{%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value
-%}

<section class="section section--tight" id="avis">
  <div class="page-width reviews">
    <div class="reviews__summary">
      <h2 class="reviews__label">{{ section.settings.heading }}</h2>

      {%- if rating != blank and rating.rating > 0 -%}
        {%- assign filled = rating.rating | round -%}
        <div class="reviews__score">{{ rating.rating }}/{{ rating.scale_max }}</div>
        <div class="stars__marks" aria-hidden="true">
          {%- for i in (1..5) -%}{% if i <= filled %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
        </div>
        {%- if count > 0 -%}
          <p class="mention">{{ 'products.reviews.based_on' | t: count: count }}</p>
        {%- endif -%}
      {%- else -%}
        <p class="mention">{{ 'products.reviews.none' | t }}</p>
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        <a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="reviews__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'quote' -%}
            <figure class="quote" {{ block.shopify_attributes }}>
              {%- if block.settings.stars > 0 -%}
                <div class="stars__marks" aria-label="{{ block.settings.stars }}/5">
                  {%- for i in (1..block.settings.stars) -%}&#9733;{%- endfor -%}
                </div>
              {%- endif -%}
              <blockquote><p>{{ block.settings.text }}</p></blockquote>
              <figcaption class="quote__author">
                {{ block.settings.author }}
                {%- if block.settings.verified -%}
                  <span class="quote__verified">
                    {% render 'icon', name: 'check-circle', size: 13 %}
                    {{ 'products.reviews.verified' | t }}
                  </span>
                {%- endif -%}
              </figcaption>
            </figure>

          {%- else -%}
            {%- comment -%} Bloc d'application d'avis {%- endcomment -%}
            <div class="reviews__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Avis clients" },
    { "type": "url", "id": "link", "label": "Lien vers tous les avis" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir tous les avis" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Citation",
      "settings": [
        { "type": "range", "id": "stars", "label": "Note", "min": 0, "max": 5, "step": 1, "default": 5 },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "default": "Qualité incroyable, je ne la quitte plus. Elle va avec tout !"
        },
        { "type": "text", "id": "author", "label": "Signature", "default": "Camille D." },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": true }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}

{%- comment -%} Les arguments de réassurance, en colonnes sobres. {%- endcomment -%}
<section class="section section--tight" style="background: {{ section.settings.background }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="columns columns--{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div class="col__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promesses",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "#FAF9F7", "label": "Ivoire" },
        { "value": "#FFFFFF", "label": "Blanc" }
      ],
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "promesse",
      "name": "Promesse",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "water", "label": "Résistant à l'eau" },
            { "value": "gem", "label": "Plaqué or" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retours" },
            { "value": "leaf", "label": "Durable" }
          ],
          "default": "gem"
        },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Plaqué or 18 carats" },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "3 microns d'or sur laiton, pour une tenue durable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promesses",
      "blocks": [
        { "type": "promesse" },
        { "type": "promesse" },
        { "type": "promesse" }
      ]
    }
  ]
}
{% endschema %}

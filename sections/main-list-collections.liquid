<div class="page-width">
  <header class="collection-header">
    <p class="eyebrow">{{ 'collections.general.eyebrow' | t }}</p>
    <h1>{{ page_title }}</h1>
  </header>

  <ul class="product-grid" style="list-style:none">
    {%- for collection in collections -%}
      <li>
        <a class="collection-tile" href="{{ collection.url }}">
          {%- if collection.featured_image -%}
            <img
              src="{{ collection.featured_image | image_url: width: 800 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              width="{{ collection.featured_image.width }}"
              height="{{ collection.featured_image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <span class="placeholder">{% render 'logo', width: 80, unique_id: collection.id %}</span>
          {%- endif -%}
          <span class="collection-tile__label">{{ collection.title }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  <div style="height: var(--section-y)"></div>
</div>

{% schema %}
{ "name": "Liste des collections" }
{% endschema %}

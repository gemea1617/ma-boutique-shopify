{%- comment -%}
  Bandeau de réassurance pleine largeur, séparé par des filets verticaux.
{%- endcomment -%}
<section class="reassure">
  <div class="page-width reassure__grid">
    {%- for block in section.blocks -%}
      <div class="reassure__item" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon, size: 26 %}
        <div>
          <div class="reassure__title">{{ block.settings.heading }}</div>
          <div class="reassure__sub">{{ block.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau de réassurance",
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retours" },
            { "value": "lock", "label": "Paiement sécurisé" },
            { "value": "gift", "label": "Emballage cadeau" },
            { "value": "shield", "label": "Garantie" },
            { "value": "gem", "label": "Matière" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison offerte" },
        { "type": "text", "id": "text", "label": "Détail", "default": "dès 100 € d'achat" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau de réassurance",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}

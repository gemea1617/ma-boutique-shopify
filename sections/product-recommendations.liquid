{%- comment -%}
  Recommandations produit. Shopify ne renseigne `recommendations` que sur la
  requête dédiée : au premier rendu la section est donc vide, et le script la
  recharge via l'API de recommandations. C'est le comportement attendu — la
  fiche produit ne paie pas le calcul des suggestions.
{%- endcomment -%}

<div
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section">
      <div class="page-width">
        <div class="section-head section-head--center">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>

        <ul class="product-grid product-grid--4">
          {%- for product in recommendations.products -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Produits associés",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Il ira bien avec" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "À porter ensemble" },
    {
      "type": "range",
      "id": "count",
      "label": "Nombre de produits",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}

{%- comment -%}
  « Vous aimerez aussi ». Shopify ne renseigne `recommendations` que sur la
  requête dédiée : la section est vide au premier rendu et le script la
  remplace. La fiche produit ne paie donc pas le calcul des suggestions —
  ce qui compte quand le catalogue dépasse la centaine de références.
{%- endcomment -%}

<div
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section section--tight">
      <div class="page-width">
        <div class="row-head">
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.link != blank -%}
            <a class="link-line" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
          {%- endif -%}
        </div>

        <div class="carousel" data-carousel>
          <button class="carousel__arrow carousel__arrow--prev" type="button" data-scroll="-1" aria-label="{{ 'general.previous' | t }}">
            {% render 'icon', name: 'arrow-left', size: 16 %}
          </button>

          <ul class="rail" data-carousel-track>
            {%- for product in recommendations.products -%}
              {% render 'product-card', card_product: product %}
            {%- endfor -%}
          </ul>

          <button class="carousel__arrow carousel__arrow--next" type="button" data-scroll="1" aria-label="{{ 'general.next' | t }}">
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </button>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Vous aimerez aussi",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir tout" },
    {
      "type": "range",
      "id": "count",
      "label": "Nombre de produits",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}

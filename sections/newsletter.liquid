<section class="newsletter">
  <div class="page-width newsletter__grid">
    <div class="newsletter__copy">
      {% render 'icon', name: 'message', size: 24 %}
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
    </div>

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
      <input
        id="NewsletterEmail"
        type="email"
        name="contact[email]"
        placeholder="{{ 'newsletter.placeholder' | t }}"
        autocomplete="email"
        required
      >
      <button class="btn-icon btn-icon--solid" type="submit" aria-label="{{ section.settings.button_label }}">
        {% render 'icon', name: 'arrow-right', size: 16 %}
      </button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter__message">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter__message">{{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rejoignez l'univers GEMEA" },
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Inscrivez-vous et profitez de -10 % sur votre première commande."
    },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "S'inscrire" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

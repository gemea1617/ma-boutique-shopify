          "block_order": [
            "title",
            "link"
          ]
        },
        "fa": {
          "type": "accordion",
          "settings": {
            "icon": "plus",
            "type_preset": "paragraph"
          },
          "blocks": {
            "q1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "La bague résiste-t-elle à l'eau ?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Oui. L'argent 925 massif supporte l'eau sans s'altérer. Nous vous conseillons toutefois de retirer votre bijou avant la piscine ou la mer, le chlore et le sel pouvant ternir la finition à long terme.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "q2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "L'argent 925 va-t-il s'oxyder avec le temps ?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>L'argent peut légèrement se patiner. Un passage de chiffon doux suffit à lui rendre son éclat d'origine.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "q3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Puis-je retourner ou échanger mon bijou ?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Vous disposez de 30 jours pour nous retourner votre commande, retour offert. Le bijou doit être non porté et dans son écrin d'origine.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "q4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Comment connaître ma taille de bague ?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Consultez notre guide des tailles : il vous explique comment mesurer votre doigt en moins d'une minute, avec un simple bout de papier.</p>",
                    "width": "100%"
                  }
                }
              },
              "block_order": [
                "text"
              ]
            }
          },
          "block_order": [
            "q1",
            "q2",
            "q3",
            "q4"
          ]
        }
      },
      "block_order": [
        "fh",
        "fa"
      ],
      "name": "FAQ"
    },

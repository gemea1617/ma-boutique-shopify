<div class="page-width empty-state">
  {% render 'logo', width: 100, unique_id: 'password' %}
  <h1 style="margin-top:26px">{{ shop.name }}</h1>
  <p>{{ shop.password_message | default: 'Boutique bientôt ouverte.' }}</p>

  {%- form 'storefront_password' -%}
    <div class="field" style="max-width:340px; margin:0 auto 18px; text-align:left">
      <label for="Password">{{ 'general.password_page.password' | t }}</label>
      <input id="Password" type="password" name="password" autocomplete="current-password">
    </div>
    {%- if form.errors -%}
      <p class="form-message form-message--error">{{ form.errors.messages.form }}</p>
    {%- endif -%}
    <button class="btn" type="submit">{{ 'general.password_page.enter' | t }}</button>
  {%- endform -%}
</div>

<div class="page-width page-width--narrow section" style="max-width:440px">
  <h1 style="text-align:center; margin-bottom:32px">{{ 'customer.reset_password.title' | t }}</h1>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password">
    </div>

    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
      <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password">
    </div>

    <button class="btn btn--full" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

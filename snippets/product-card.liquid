{%- comment -%}
  Carte produit. Accepte : card_product, image_ratio (non utilisé pour l'instant),
  show_vendor (bool).
{%- endcomment -%}

{%- if card_product and card_product != empty -%}
  <li class="card">
    <a class="card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_media -%}
        <img
          class="card__img--main"
          src="{{ card_product.featured_media | image_url: width: 800 }}"
          srcset="
            {{ card_product.featured_media | image_url: width: 400 }} 400w,
            {{ card_product.featured_media | image_url: width: 800 }} 800w,
            {{ card_product.featured_media | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 1200px) 320px, (min-width: 750px) 30vw, 45vw"
          alt="{{ card_product.featured_media.alt | escape }}"
          width="{{ card_product.featured_media.width }}"
          height="{{ card_product.featured_media.height }}"
          loading="lazy"
        >
        {%- if card_product.media[1] -%}
          <img
            class="card__img--hover"
            src="{{ card_product.media[1] | image_url: width: 800 }}"
            alt=""
            width="{{ card_product.media[1].width }}"
            height="{{ card_product.media[1].height }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <span class="placeholder">{% render 'logo', width: 62, unique_id: card_product.id %}</span>
      {%- endif -%}

      {%- if card_product.available == false -%}
        <span class="card__badge card__badge--sold">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        <span class="card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </a>

    <div class="card__info">
      {%- if show_vendor and card_product.vendor != blank -%}
        <div class="eyebrow" style="margin-bottom:6px">{{ card_product.vendor }}</div>
      {%- endif -%}
      <a class="card__title" href="{{ card_product.url }}">{{ card_product.title }}</a>
      <div class="card__price">{% render 'price', target: card_product, show_from: true %}</div>
    </div>
  </li>
{%- else -%}
  {%- comment -%} Squelette affiché dans l'éditeur tant qu'aucun produit n'est choisi {%- endcomment -%}
  <li class="card">
    <span class="card__media"><span class="placeholder">{% render 'logo', width: 62, unique_id: 'ph' %}</span></span>
    <div class="card__info">
      <span class="card__title">{{ 'onboarding.product_title' | t }}</span>
      <div class="card__price">{{ 1990 | money }}</div>
    </div>
  </li>
{%- endif -%}
